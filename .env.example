# Etherscan
ETHERSCAN_API_KEY=

# RPCs
SEPOLIA_RPC_URL=
HOODI_RPC_URL=
MAINNET_RPC_URL=

# Private keys (hex with 0x prefix)
DEPLOYER_PRIVATE_KEY=

LENDER_1_PRIVATE_KEY=
LENDER_2_PRIVATE_KEY=
LENDER_3_PRIVATE_KEY=
BORROWER_PRIVATE_KEY=

# Borrower-only best-effort script inputs
FLASHLOAN_BEST_EFFORT_LENDER_ADDRESSES=0x...,0x...
FLASHLOAN_BEST_EFFORT_TOKEN_ADDRESSES=0x...,0x...
# Leave blank or set to null to read available amounts from LenderRegistry.
FLASHLOAN_BEST_EFFORT_AMOUNTS=1.5,2000
